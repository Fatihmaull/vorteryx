# ═══════════════════════════════════════════════════════
# VoteryX Smart Contracts — Environment Variables
# ═══════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Sepolia RPC URL (get from Alchemy or Infura)
# Alchemy: https://www.alchemy.com/
# Infura: https://www.infura.io/
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Private key of the deployer wallet (without 0x prefix)
# ⚠️ NEVER use a wallet with real funds on mainnet!
# Get Sepolia ETH from: https://sepoliafaucet.com/
PRIVATE_KEY=your_private_key_here

# Etherscan API key for contract verification
# Get from: https://etherscan.io/apis
ETHERSCAN_API_KEY=your_etherscan_api_key

# Gas reporting (set to "true" to enable)
REPORT_GAS=false
